# Copy this file to `.env` and fill in your real keys.
# `.env` is git-ignored, so your real keys are never committed.

# --- Composio SDK (composio-*.mjs scripts) ---
# Get your API key from the Composio dashboard: https://app.composio.dev  (Settings -> API Keys)
COMPOSIO_API_KEY=your_composio_api_key_here

# --- MCP servers (.mcp.json) ---
# These are read by `.mcp.json` via ${VAR} expansion. See MCP.md.
# Free key from https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
# Paid key from https://www.perplexity.ai/account/api  (starts with pplx-)
PERPLEXITY_API_KEY=your_perplexity_api_key_here
