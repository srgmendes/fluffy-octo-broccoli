# Stirling-PDF initial admin credentials.
#
# Copy this file to `.env` (same directory as docker-compose.yml) and set your
# own values BEFORE the first `docker compose up`. These create the initial
# admin account on first startup only — changing them afterward does NOT change
# an already-created account (do that from the app's account settings).
#
#   cp .env.example .env
#
# `.env` is git-ignored so your real credentials stay out of version control.

STIRLING_ADMIN_USERNAME=admin
STIRLING_ADMIN_PASSWORD=change-me-please

# Domain the Caddy reverse proxy serves HTTPS on.
#   * localhost              -> HTTPS via Caddy's internal CA (default).
#   * your.public.domain     -> automatic Let's Encrypt certificate
#                               (ports 80 + 443 must be publicly reachable and
#                                DNS must point at this host).
STIRLING_DOMAIN=localhost

# Per-client-IP rate limit enforced by the Caddy proxy: at most
# RATE_LIMIT_EVENTS requests per RATE_LIMIT_WINDOW, then HTTP 429. Raise the
# events count if heavy pages get throttled; lower it to tighten protection.
RATE_LIMIT_EVENTS=200
RATE_LIMIT_WINDOW=1m
