# Stirling-PDF initial admin credentials.
#
# Copy this file to `.env` (same directory as docker-compose.yml) and set your
# own values BEFORE the first `docker compose up`. These create the initial
# admin account on first startup only — changing them afterward does NOT change
# an already-created account (do that from the app's account settings).
#
#   cp .env.example .env
#
# `.env` is git-ignored so your real credentials stay out of version control.

STIRLING_ADMIN_USERNAME=admin
STIRLING_ADMIN_PASSWORD=change-me-please
