# HTTP Basic Auth credentials for the Caddy reverse proxy.
#
# Copy this file to `proxy-auth.env` (same directory as docker-compose.yml):
#
#   cp proxy-auth.env.example proxy-auth.env
#
# `proxy-auth.env` is git-ignored so your credentials stay out of version control.
# These values are passed to the Caddy container literally (via env_file), so the
# bcrypt hash's `$` characters need NO escaping here.
#
# The default below is the bcrypt hash of the password "changeme" — CHANGE IT.
# Generate a new hash with either:
#
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
#   # or, with Python:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt(rounds=14)).decode())"

PROXY_BASICAUTH_USERNAME=admin
PROXY_BASICAUTH_HASH=$2b$14$76mMm6brH9Rs40yrjHQ/M.5kB7DrepBPTF/6I3gEsJBPOejV9upfy
