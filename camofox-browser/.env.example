# camofox-browser optional configuration.
#
# Copy this file to `.env` (same directory as docker-compose.yml) only if you
# need to change a default — a private, localhost-only setup needs none of it.
#
#   cp .env.example .env
#
# `.env` is git-ignored so real secrets stay out of version control.

# Node old-space heap cap (MB). The server idles low; raise only if heavy pages
# push it into out-of-memory restarts.
MAX_OLD_SPACE_SIZE=128

# --- Optional authentication ---
# Global bearer token gating EVERY REST call (the "superkey"). Leave empty for
# an unauthenticated localhost server. If you set it, you MUST set the SAME
# value as CAMOFOX_ACCESS_KEY in ../.mcp.json's `env` block, or every MCP tool
# call gets 401/403.
CAMOFOX_ACCESS_KEY=

# Self-chosen secret gating cookie import only (the camofox_import_cookies
# tool). Optional on localhost; required if you expose the server remotely. If
# set, add the same value as CAMOFOX_API_KEY to ../.mcp.json's `env` block.
CAMOFOX_API_KEY=
