# FreeLLMAPI runtime configuration.
#
# Copy this file to `.env` (same directory as docker-compose.yml) and set your
# own values BEFORE the first `docker compose up`:
#
#   cp .env.example .env
#   printf 'ENCRYPTION_KEY=%s\n' "$(openssl rand -hex 32)" >> .env   # then drop the placeholder below
#
# `.env` is git-ignored so your real key stays out of version control.

# REQUIRED. 64-character hex string (32 bytes) used to encrypt the provider API
# keys FreeLLMAPI stores at rest. Generate one with:
#
#   openssl rand -hex 32
#
# Losing or changing this key makes every stored provider key undecryptable —
# back it up alongside your other secrets.
ENCRYPTION_KEY=replace-me-with-openssl-rand-hex-32

# Host port the dashboard and the OpenAI-compatible /v1 endpoint are published
# on. The container always listens on 3001 internally.
PORT=3001

# Host interface the port is published on.
#   * 127.0.0.1 -> localhost only (default, recommended).
#   * 0.0.0.0   -> reachable from your LAN. Only on a trusted network: the
#                  service is single-user and guarded only by its unified API key.
HOST_BIND=127.0.0.1

# Request-analytics retention. Whichever limit prunes first wins; set either to
# 0 to disable that limit.
REQUEST_ANALYTICS_RETENTION_DAYS=90
REQUEST_ANALYTICS_MAX_ROWS=100000

# Optional. Route outbound provider calls through a proxy. A proxy listening on
# the host's loopback is NOT reachable as 127.0.0.1 from inside the container —
# use host.docker.internal, which docker-compose.yml maps to the host gateway.
#
#   PROXY_URL=socks5h://host.docker.internal:7890
